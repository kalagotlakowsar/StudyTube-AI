# StudyTube AI Environment Variables

# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Security
SECRET_KEY=studytube-super-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database (SQLite by default, or postgresql://user:pass@localhost:5432/studytube)
DATABASE_URL=sqlite:///./studytube.db

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
